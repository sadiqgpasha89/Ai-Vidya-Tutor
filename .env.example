# Copy to .env. Every line is optional; the defaults give you a local Llama 3.1 teacher with accounts switched on.

# ---- the model (default: local, via Ollama) --------------------------------------------------------------
TEACHER_PROVIDER=ollama                 # ollama | anthropic
# Each job has its own model. Defaults (run ./scripts/pull_models.sh to download them):
#   everyday  gemma4:e4b   lessons, chat, 5-minute summaries, cheat sheets, quizzes, photos of homework
#   specialist gpt-oss:20b pictures/diagrams, fact-checking, tie-breaks on practice answers (loads when needed, then makes room again)
# If a default model is not installed AIVidya quietly uses another installed one, so a missing download never stops the app.
# TEACHER_MODEL=llama3.1:8b             # use ONE model for all everyday jobs (any Ollama model with tool support); or claude-opus-5-5 with anthropic
# TEACHER_MODEL_LESSON=                 # per-job overrides: LESSON CHAT SUMMARY CHEATSHEET QUIZ VISION FIGURE FACTCHECK STRONG
# TEACHER_MODEL_FIGURE=gpt-oss:20b      # who draws the pictures
# TEACHER_MODEL_STRONG=gpt-oss:20b      # also send hard maths/physics chat questions to a bigger model (off by default: slower on a 16 GB GPU)
# TEACHER_EMBED_MODEL=nomic-embed-text  # meaning-based search and textbook retrieval
# OLLAMA_HOST=http://127.0.0.1:11434
# TEACHER_NUM_CTX=12288
# TEACHER_CONCURRENCY=1                 # model calls at once (raise it together with OLLAMA_NUM_PARALLEL on a big GPU)
# TEACHER_VERIFY_CHAT=1                 # second-model check of numeric answers (slower, more accurate)
# ANTHROPIC_API_KEY=

# ---- accounts & security -------------------------------------------------------------------------------------------
# TEACHER_AUTH=off                      # single-person mode: no sign-in (default: on)
# TEACHER_ADMIN_USER=admin              # creates this administrator on first start ...
# TEACHER_ADMIN_PASSWORD=change-me-now  # ... (8+ characters)
# TEACHER_COOKIE_SECURE=1               # set when served over HTTPS
# TEACHER_RATE_AI=40                    # AI requests per user per minute
# TEACHER_RATE_AUTH=12                  # sign-in attempts per IP per minute
# TEACHER_SESSION_DAYS=30
# Prepare things in the background while the model is idle (pictures, facts and summaries of new lessons; the next topic's lesson). 0 = off
# TEACHER_PREFETCH=1
# Sign out after this many minutes with no activity (the browser tells the server while the student is reading or scrolling)
# TEACHER_IDLE_MINUTES=120
# "Keep me signed in on this device": how many days that sign-in lasts (it is not ended by the idle limit above)
# TEACHER_REMEMBER_DAYS=30
# TEACHER_METRICS_TOKEN=                # bearer token so Prometheus can read /metrics from another machine

# ---- voice ----------------------------------------------------------------------------------------------------------------
# TEACHER_TTS=piper                     # server voices (piper) or off
# TEACHER_STT=whisper                   # private speech recognition (whisper) or off
# TEACHER_WHISPER_MODEL=large-v3-turbo  # speech recognition: large-v3-turbo (best for Indian languages, ~1.6 GB) | small | base (lightest)

# ---- notifications (all optional; in-app reminders always work) ---------------------------------------------------
# Email. Needed for sign-up and "Forgot password": each sends a 6-digit code to the person's email address. Without SMTP_HOST nothing is emailed;
# the code is written to the server log instead (fine for trying AIVidya on your own computer, not for a school).
# SMTP_HOST=smtp.example.com  SMTP_PORT=587  SMTP_USER=  SMTP_PASSWORD=  SMTP_FROM=aividya@example.com
# SMTP_SECURITY=starttls     # starttls (port 587, most providers), ssl (port 465) or none (a mail relay on the same network)
# TEACHER_OTP_MINUTES=10     # how long an emailed code works
# TEACHER_OTP_RESEND_SECONDS=60
# VAPID_PUBLIC_KEY=  VAPID_PRIVATE_KEY=  VAPID_SUBJECT=mailto:you@example.com    # web push (generate with `vapid --gen`)
# WHATSAPP_TOKEN=  WHATSAPP_PHONE_ID=                                           # Meta WhatsApp Cloud API

# ---- operations ------------------------------------------------------------------------------------------------------------
# TEACHER_DATA_DIR=./data
# TEACHER_BACKUP_HOURS=24               # automatic database backups (0 = off), TEACHER_BACKUP_KEEP=7
# TEACHER_LOG_JSON=1                    # one JSON object per log line
# TEACHER_WEB_SEARCH=1                  # lets the tutor search the web (off by default for privacy; needs `pip install ddgs`)

# ---- offline demo ---------------------------------------------------------------------------------------------------------
# TEACHER_MOCK=1                        # sample content, no model
